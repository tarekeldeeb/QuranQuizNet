{
  "expo": {
    "name": "Quran Quiz",
    "slug": "quranquiznet",
    "version": "2.4.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quranquiz",
    "userInterfaceStyle": "dark",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json",
      "ms": "./locales/ms.json",
      "bn": "./locales/bn.json",
      "tr": "./locales/tr.json",
      "ur": "./locales/ur.json",
      "pa": "./locales/pa.json",
      "fa": "./locales/fa.json",
      "ha": "./locales/ha.json",
      "jv": "./locales/jv.json",
      "ps": "./locales/ps.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "id": "./locales/id.json",
      "zh-Hans": "./locales/zh.json",
      "sw": "./locales/sw.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.quranquiz",
      "buildNumber": "17",
      "appleTeamId": "FNSP52WBLF",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "ar",
          "en",
          "ms",
          "bn",
          "tr",
          "ur",
          "pa",
          "fa",
          "ha",
          "jv",
          "ps",
          "fr",
          "es",
          "id",
          "zh-Hans",
          "sw"
        ]
      },
      "associatedDomains": [
        "applinks:quranquiz.net"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0d2d4e"
      },
      "edgeToEdgeEnabled": true,
      "package": "net.quranquiz",
      "versionCode": 22,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "quranquiz.net",
              "pathPrefix": "/add"
            },
            {
              "scheme": "https",
              "host": "quranquiz.net",
              "pathPrefix": "/quiz"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-localization",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Amiri-Regular.woff2",
            "./assets/fonts/UthmanTN_v2-0.woff2",
            "./assets/fonts/PlexArabic-Regular.woff2",
            "./assets/fonts/PlexArabic-SemiBold.woff2",
            "./assets/fonts/PlexArabic-Bold.woff2",
            "./assets/fonts/NotoSansBengali-Regular.woff2",
            "./assets/fonts/NotoSansBengali-Bold.woff2",
            "./assets/fonts/NotoSansSC-Regular.woff2",
            "./assets/fonts/NotoSansSC-Bold.woff2"
          ]
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#0d2d4e"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "ndkVersion": "28.2.13676358",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleAuth": {
        "iosClientId": "635224907527-h6m6o8kqoud1bcroammqlf97ip6t41lt.apps.googleusercontent.com",
        "androidClientId": "635224907527-bqg6h4e8cpel7l9q14n2b084f71hch24.apps.googleusercontent.com",
        "webClientId": "635224907527-bdic77p58a8tjkeuj96csup7tnoe870s.apps.googleusercontent.com"
      },
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5c3fe7d8-80ae-44cf-81d6-b65b253ae52f"
      }
    },
    "owner": "tarekeldeeb"
  }
}
